[Unit]
Description=Arch hardware optimization
Before=basic.target
After=sysinit.target local-fs.target
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/lib/arch/arch-hardware-optimization start
ExecStop=/usr/lib/arch/arch-hardware-optimization stop
RemainAfterExit=yes
TimeoutStartSec=2min

[Install]
WantedBy=basic.target
